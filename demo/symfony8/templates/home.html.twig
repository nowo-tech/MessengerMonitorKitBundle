{% extends 'base.html.twig' %}

{% block title %}Home - Messenger Monitor Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Messenger Monitor Kit',
        intro: 'A UiKit admin UI on top of zenstruck/messenger-monitor-bundle: message history with filters, failed messages retried to their original transport (CSRF, confirm, per-message lock), redacted payloads, a recording switch that applies without a redeploy and batched retention.',
    }) }}
{% endblock %}

{% block body %}
    <p class="nowo-ui-muted">
        The demo seed dispatched invoices, inventory syncs and page views on a Doctrine (MySQL) queue and ran a
        worker: a few failed and wait on the <code>failed</code> transport. FrankenPHP mode:
        <strong>worker</strong> by default (<code>FRANKENPHP_MODE</code>).
    </p>

    <section class="nowo-ui-card" data-testid="demo-depth">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Queue depth service</h2></div>
        <div class="nowo-ui-card__body">
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Pending</dt><dd class="nowo-ui-detail-list__value" data-testid="demo-pending">{{ depth.pending ?? '—' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Failed</dt><dd class="nowo-ui-detail-list__value" data-testid="demo-failed">{{ depth.failed ?? '—' }}</dd></div>
            </dl>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Monitor</h2></div>
        <div class="nowo-ui-card__body">
            <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_messenger_monitor_kit_dashboard') }}">Open the dashboard</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_messenger_monitor_kit_transport', {name: 'failed'}) }}">Failed messages</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_messenger_monitor_kit_history') }}">History</a>
        </div>
    </section>
{% endblock %}
