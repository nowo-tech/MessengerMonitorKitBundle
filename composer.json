{
    "name": "nowo-tech/messenger-monitor-kit-bundle",
    "description": "Symfony Messenger monitoring on top of zenstruck/messenger-monitor-bundle: runtime recording toggle, batched purge, retry to the original transport, queue depth, transport factories and a UiKit admin UI.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "bundle",
        "messenger",
        "queue",
        "monitoring",
        "admin",
        "zenstruck",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/MessengerMonitorKitBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Maintainer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "support": {
        "issues": "https://github.com/nowo-tech/MessengerMonitorKitBundle/issues",
        "source": "https://github.com/nowo-tech/MessengerMonitorKitBundle",
        "docs": "https://github.com/nowo-tech/MessengerMonitorKitBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/MessengerMonitorKitBundle/blob/main/docs/CHANGELOG.md"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\MessengerMonitorKitBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
